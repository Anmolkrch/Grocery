@model Grocery.Models.HomeProductViewModel
@using Grocery.DAL
@{ ViewBag.Title = "ProductDetail";
    Layout = "~/Views/Shared/_FrontLayout.cshtml";
    List<Grocery.Models.ProductViewModel> SimilarProducts = (List<Grocery.Models.ProductViewModel>)ViewBag.SimilarProducts;
}
<style>
    .servicesList .servicesBox .servicesImg img {
        height: 145px;
    }
</style> <!--Start product Details--> <div class="servicefinal">
    <div class="container">
        <div class="servicefinalLeft fl">
            <!--Start servicesdetailsBox-->
            <div class="servicesdetailsBox">
                @if (File.Exists(Server.MapPath(System.Configuration.ConfigurationManager.AppSettings["ProductImage"] + "Large/" + Model.Product.ProductId + "_" + Model.Product.ProductImage)))
                {
                    <img src="@(System.Configuration.ConfigurationManager.AppSettings["ProductImage"] + "Large/" +Model.Product.ProductId+ "_" + Model.Product.ProductImage)" /> }
                else
                {
                    <img src="@(System.Configuration.ConfigurationManager.AppSettings["ProductImage_Default"])" alt="" />
                }
                <div class="inrfinalServices">
                    <h2>@Model.Product.ProductName</h2>
                    <h3>@Model.Product.CategoryName</h3>
                </div>
            </div>
            <!--End servicesdetailsBox-->
            <!--Start Description-->
            <div class="description">
                <!--Start aboutMe-->
                <div class="aboutMe">

                    <h1 class="prfHeading">Description</h1>
                    <div class="profInnerBox innerbox1">
                        @Html.Raw(Model.Product.Description)
                    </div>
                </div>                 <!--End aboutMe-->
            </div>             <!--End Description-->
        </div>
        <div class="servicefinalRight fr">
            <!--Start Add product to cart-->
            <div class="bookaService">
                <span class="mrp">
                    ₹@Model.Product.Price
                </span>

                <span class="selling-price">
                    ₹@Model.Product.SellingPrice
                </span>

                <span class="discount">
                    @Model.Product.DiscountPercent % OFF
                </span>
                <a href="/shopping/addproducttocart?productId=@Model.Product.ProductId" class="bookreviewBtn" type="button">Add to cart</a>
            </div>
            <!--End Add product to cart-->
            <!--Start Similar Products-->
            <div class="favorite">
                <div class="othersViewed"><span>Similar Products</span></div>
            </div>             <div class="viewList">
                <ul class="servicesList">
                    @if (SimilarProducts.Count > 0)
                    {
                        foreach (var ov in SimilarProducts)
                        {
                            <li>
                                <!--Start ServicesBox-->
                                <div class="servicesBox">
                                    <div class="servicesImg">
                                        @if (File.Exists(Server.MapPath(System.Configuration.ConfigurationManager.AppSettings["ProductImage"] + "Medium/" + ov.ProductId + "_" + ov.ProductImage)))
                                        {
                                            <img src="@(System.Configuration.ConfigurationManager.AppSettings["ProductImage"] + "Medium/" + ov.ProductId + "_" + ov.ProductImage)" />
                                        }
                                        else
                                        {
                                            <img src="/images/No Photo.png" alt="" />
                                        }
                                    </div>
                                    <div class="nameLink">
                                        <a href="/search/productdetail?pId=@ov.ProductId" title="View product details">@ov.ProductName</a>
                                        <div class="byperson clearfix">
                                            <div class="prsonLeft fl"><h3>Category : @ov.CategoryName</h3></div>
                                        </div>
                                    </div>
                                    <div class="">
                                        <div class="bookaService">
                                            <span class="mrp">
                                                ₹@ov.Price
                                            </span>

                                            <span class="selling-price">
                                                ₹@ov.SellingPrice
                                            </span>

                                            <span class="discount">
                                                @ov.DiscountPercent % OFF
                                            </span>
                                            <br />
                                        </div>
                                    </div>
                                </div>                                 <!--End Similar Products-->
                            </li>
                        }
                    }
                    else
                    {
                        <li>
                            No similar products
                            <div class="servicesBox">
                            </div>
                        </li>
                    }
                </ul>                 <!--End list-->
            </div>
        </div>
    </div>
</div> <!--End product Details--> 