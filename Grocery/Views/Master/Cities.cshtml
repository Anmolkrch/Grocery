@model List<Grocery.Models.CityViewModel>
@{
    ViewBag.Title = "Cities";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="rightpart">
    <div class="sechBx clearfix">
        <div class="bretcrum">Dashboard</div>
    </div>
    <div class="dashBx">
        <div class="dashboardHD">Cities</div>
        <div id="AddNewPage">
            <a href="/Master/AddCity" class="AddNewContent">Add New City</a>
        </div>
        @if (Model.Count > 0)
        {
            <div class="dashTable" id="rootId">
                <table id="tblId">
                    <thead>
                        <tr>
                            <th>Sr. No.</th>
                            <th>State</th>
                            <th>City Name</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(Model.IndexOf(item) + 1)</td>
                                <td>@item.StateName</td>
                                <td>@item.CityName</td>
                                <!-- or show StateName if you include it in the ViewModel -->
                                <td>@(item.IsActive ? "Yes" : "No")</td>
                                <td>
                                    @Html.ActionLink("Edit", "UpdateCity", "Master", new { cityId = item.CityId }, new { @class = "editBtn" })
                                    <a href="javascript:void(0)" onclick="deletedata(@item.CityId)" class="delBtn">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <br />
            <br />
            <div class="NoRecord">
                <h3>No records found</h3>
                <div class="clearfix"></div>
                <div class="dashfrm-L submitBtns">
                    <a onclick="window.history.back();" class="editBtn cancelBtn" style="width: 48%;"><< Back</a>
                </div>
            </div>
        }
    </div>
</div>

@section js{
    <script>
    $(document).ready(function () {
        $('#tblId').dataTable({
            columnDefs: [
                { orderable: false, targets: -1 }
            ]
        });
    });

    function deletedata(x) {
        SweetAlertDeleteConfirmation(
            'warning',
            '',
            'Are you sure, you want to delete this city?',
            '',
            'City deleted successfully.',
            '',
            'City is not deleted',
            '/Admin/DeleteCity',
            x
        );
    }
    </script>
}
