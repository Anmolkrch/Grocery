@model List<OnlineShopping.Models.UserViewModel>
@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="rightpart">
    <div class="sechBx clearfix">
        <div class="bretcrum">Dashboard</div>
    </div>
    <div class="dashBx">
        <div class="dashboardHD">Users</div>
        <div id="AddNewPage">
            <a href="/User/AddUser" class="AddNewContent">Add New User</a>
        </div>
        @if (Model.Count > 0)
        {
            <div class="dashTable" id="rootId">
                <table id="tblId">
                    <thead>
                        <tr>
                            <th>Sr. No.</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(Model.IndexOf(item) + 1)</td>
                                <td>@(item.FirstName + " " + item.LastName)</td>
                                <td>@item.EmailId</td>
                                <td>@item.RoleName</td>
                                <td>@(item.IsActive ? "Yes" : "No")</td>
                                <td>
                                    @Html.ActionLink("Edit", "UpdateUser", "User", new { memberId = item.MemberId }, new { @class = "editBtn" })
                                    <a href="javascript:void(0)" onclick="deletedata(@item.MemberId)" class="delBtn">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <br />
            <br />
            <div class="NoRecord">
                <h3>No records found</h3>
                <div class="clearfix"></div>
                <div class="dashfrm-L submitBtns">
                    <a onclick="window.history.back();" class="editBtn cancelBtn" style="width: 48%;"><< Back</a>
                </div>
            </div>
        }
    </div>
</div>

@section js{
    <script>
    $(document).ready(function () {
        $('#tblId').dataTable({
            columnDefs: [
                { orderable: false, targets: -1 }
            ]
        });
    });

    function deletedata(x) {
        SweetAlertDeleteConfirmation(
            'warning',
            '',
            'Are you sure, you want to delete this user?',
            '',
            'User deleted successfully.',
            '',
            'User is not deleted',
            '/User/DeleteUser',
            x
        );
    }
    </script>
}
